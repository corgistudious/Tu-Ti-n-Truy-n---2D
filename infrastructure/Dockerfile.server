# Server game (Node.js/TypeScript) — build đa tầng
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY asset-pipeline/package.json asset-pipeline/
RUN npm ci --ignore-scripts
COPY tsconfig.base.json ./
COPY shared shared
COPY server server
RUN npm run build -w server && npm prune --omit=dev --ignore-scripts

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S game && adduser -S game -G game
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/server/dist server/dist
COPY --from=build /app/server/package.json server/package.json
COPY database database
COPY admin admin
# bản xuất Godot Web (tùy chọn) — build bằng scripts/build-web.sh trước khi build image
COPY client/export/web client-web
ENV MIGRATIONS_DIR=/app/database/migrations ADMIN_DIR=/app/admin CLIENT_DIR=/app/client-web PORT=8080
WORKDIR /app/server
USER game
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["node", "dist/index.js"]
