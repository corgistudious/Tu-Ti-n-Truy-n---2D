# Sao chép thành .env và điền giá trị THẬT. Không commit file .env.
NODE_ENV=production
PUBLIC_URL=https://game.example.com
POSTGRES_DB=tutien
POSTGRES_USER=tutien
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CORS_ORIGINS=https://game.example.com
# SMTP thật để gửi email xác thực/đặt lại mật khẩu, vd smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Tu Tiên Truyện 2D <no-reply@example.com>"
REQUIRE_EMAIL_VERIFIED=false
# Asset Pipeline API Mode (tùy chọn) — chỉ đặt ở server, KHÔNG bao giờ nhúng vào client
OPENAI_API_KEY=
ASSET_API_ENABLED=false
CERTS_DIR=./certs
