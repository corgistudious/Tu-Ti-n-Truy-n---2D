{
  "name": "@tt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts src/migrate.ts src/cli/admin.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external --alias:@tt/shared=../shared/src/index.ts --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "migrate": "tsx src/migrate.ts",
    "admin:create": "tsx src/cli/admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@tt/shared": "*",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
